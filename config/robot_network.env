# Fixed point-to-point Ethernet topology for the dual Franka setup.
#
# Host PC A (left): 172.16.0.1/24  ->  FR3 A / Desk: 172.16.0.2
# Host PC B (right): 172.16.0.3/24 ->  FR3 B / Desk: 172.16.0.4
#
# Keep these addresses distinct.  Do not replace them with a discovery scan:
# a duplicate Desk address makes both browser sessions share one control token.
PICO_LEFT_HOST_IP="172.16.0.1"
PICO_RIGHT_HOST_IP="172.16.0.3"
FRANKA_NETMASK="255.255.255.0"
FRANKA_LEFT_HOST_PC_IP="172.16.0.1"
FRANKA_RIGHT_HOST_PC_IP="172.16.0.3"
FRANKA_LEFT_ROBOT_IP="172.16.0.2"
FRANKA_RIGHT_ROBOT_IP="172.16.0.4"
FRANKA_LEFT_GATEWAY="172.16.0.1"
FRANKA_RIGHT_GATEWAY="172.16.0.3"
FRANKA_DESK_PORT="443"
FRANKA_FCI_PORT="1337"
